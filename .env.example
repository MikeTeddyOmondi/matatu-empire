# Copy to .env (never commit .env). Used by `just publish` and `just publish-api`.
# API key: Creator Dashboard > Open Cloud > API Keys, add the universe-places API with Write on this experience.
ROBLOX_API_KEY=
# Universe (experience) ID: Creations page > the experience's ... menu > Copy Universe ID.
ROBLOX_UNIVERSE_ID=
# Place ID: the number in the place's URL (roblox.com/games/<PLACE_ID>/...).
ROBLOX_PLACE_ID=
